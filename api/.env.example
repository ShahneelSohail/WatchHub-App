NODE_ENV=development
PORT=4000

# PostgreSQL. `npm run db:dev` starts a local database on this URL, or use docker compose.
DATABASE_URL=postgresql://watchhub:watchhub@localhost:5432/watchhub

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000

# Public URL of the web app, used for Stripe Checkout redirects
WEB_URL=http://localhost:3000

# Stripe TEST mode keys from https://dashboard.stripe.com/test/apikeys (never commit real values).
# Leave empty to run with Cash on Delivery only.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=
