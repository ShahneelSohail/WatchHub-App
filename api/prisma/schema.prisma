generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum WatchStatus {
  DRAFT
  PUBLISHED
}

enum StrapType {
  BELT
  CHAIN
}

enum ReviewStatus {
  APPROVED
  HIDDEN
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  STRIPE
  COD
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTLY_REFUNDED
  REFUNDED
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum TicketStatus {
  OPEN
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  MEDIUM
  HIGH
  URGENT
}

enum TicketMessageKind {
  CUSTOMER
  ADMIN
  INTERNAL
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())

  addresses          Address[]
  cartItems          CartItem[]
  wishlist           WishlistItem[]
  reviews            Review[]
  orders             Order[]
  notifications      Notification[]
  tickets            SupportTicket[]
  ticketReplies      TicketMessage[]
  orderNotes         OrderNote[]
  stockSubscriptions StockSubscription[]
  passwordResets     PasswordReset[]
}

model Address {
  id          Int      @id @default(autoincrement())
  userId      Int
  recipient   String
  addressLine String
  city        String
  state       String
  zip         String
  country     String
  phone       String?
  label       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Brand {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  logoUrl     String?
  watches     Watch[]
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  imageUrl    String?
  watches     Watch[]
}

model Watch {
  id                Int         @id @default(autoincrement())
  sku               String      @unique
  slug              String      @unique
  name              String
  description       String
  brandId           Int
  categoryId        Int
  price             Decimal     @db.Decimal(10, 2)
  salePrice         Decimal?    @db.Decimal(10, 2)
  stock             Int         @default(0)
  images            String[]
  specifications    Json        @default("{}")
  hasBeltOption     Boolean     @default(false)
  hasChainOption    Boolean     @default(false)
  status            WatchStatus @default(PUBLISHED)
  isFeatured        Boolean     @default(false)
  isLimitedEdition  Boolean     @default(false)
  unitsSold         Int         @default(0)
  lowStockThreshold Int         @default(5)
  isNew             Boolean     @default(false)
  trackColorStock   Boolean     @default(false)
  createdAt         DateTime    @default(now())

  brand              Brand               @relation(fields: [brandId], references: [id], onDelete: NoAction)
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  colors             WatchColor[]
  cartItems          CartItem[]
  wishlist           WishlistItem[]
  reviews            Review[]
  orderItems         OrderItem[]
  banners            Banner[]
  stockAdjustments   StockAdjustment[]
  stockSubscriptions StockSubscription[]

  @@index([brandId])
  @@index([categoryId])
  @@index([status, isFeatured])
}

model WatchColor {
  id      Int     @id @default(autoincrement())
  watchId Int
  name    String
  hex     String
  image   String?
  stock   Int     @default(0)
  watch   Watch   @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([watchId])
}

model CartItem {
  id           Int        @id @default(autoincrement())
  userId       Int
  watchId      Int
  quantity     Int
  strapType    StrapType?
  strapColor   String?
  productColor String?
  createdAt    DateTime   @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id      Int      @id @default(autoincrement())
  userId  Int
  watchId Int
  addedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([userId, watchId])
}

model Review {
  id         Int          @id @default(autoincrement())
  userId     Int
  watchId    Int
  rating     Int
  comment    String
  status     ReviewStatus @default(APPROVED)
  adminReply String?
  createdAt  DateTime     @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([userId, watchId])
  @@index([watchId, status])
}

model Coupon {
  id           Int        @id @default(autoincrement())
  code         String     @unique
  type         CouponType
  value        Decimal    @db.Decimal(10, 2)
  minAmount    Decimal?   @db.Decimal(10, 2)
  startsAt     DateTime?
  expiresAt    DateTime?
  isActive     Boolean    @default(true)
  usageLimit   Int?
  usageCount   Int        @default(0)
  limitPerUser Int?
  createdAt    DateTime   @default(now())

  orders Order[]
}

model Order {
  id              Int            @id @default(autoincrement())
  userId          Int
  status          OrderStatus
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus  @default(UNPAID)
  shippingMethod  ShippingMethod
  subtotal        Decimal        @db.Decimal(10, 2)
  shippingCost    Decimal        @db.Decimal(10, 2)
  discount        Decimal        @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  couponId        Int?
  shippingAddress Json
  stripeSessionId String?        @unique
  trackingNumber  String?
  courierName     String?
  adminNote       String?
  refundedAmount  Decimal        @default(0) @db.Decimal(10, 2)
  createdAt       DateTime       @default(now())

  user    User            @relation(fields: [userId], references: [id])
  coupon  Coupon?         @relation(fields: [couponId], references: [id])
  items   OrderItem[]
  events  OrderEvent[]
  refunds Refund[]
  notes   OrderNote[]
  tickets SupportTicket[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id           Int        @id @default(autoincrement())
  orderId      Int
  watchId      Int?
  name         String
  image        String?
  quantity     Int
  unitPrice    Decimal    @db.Decimal(10, 2)
  strapType    StrapType?
  strapColor   String?
  productColor String?

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  watch Watch? @relation(fields: [watchId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderEvent {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  note      String?
  actor     String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Banner {
  id        Int     @id @default(autoincrement())
  imageUrl  String
  eyebrow   String?
  watchId   Int?
  title     String?
  subtitle  String?
  link      String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  watch Watch? @relation(fields: [watchId], references: [id], onDelete: SetNull)
}

model Faq {
  id        Int     @id @default(autoincrement())
  question  String
  answer    String
  category  String  @default("General")
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model SupportTicket {
  id        Int            @id @default(autoincrement())
  userId    Int
  orderId   Int?
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([userId])
}

model TicketMessage {
  id        Int               @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  message   String
  kind      TicketMessageKind @default(CUSTOMER)
  createdAt DateTime          @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Refund {
  id             Int           @id @default(autoincrement())
  orderId        Int
  amount         Decimal       @db.Decimal(10, 2)
  reason         String
  method         PaymentMethod
  stripeRefundId String?
  createdAt      DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderNote {
  id        Int      @id @default(autoincrement())
  orderId   Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model StockAdjustment {
  id        Int      @id @default(autoincrement())
  watchId   Int
  variant   String?
  delta     Int
  newStock  Int
  reason    String
  actor     String
  createdAt DateTime @default(now())

  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([watchId])
}

model StockSubscription {
  id        Int      @id @default(autoincrement())
  watchId   Int
  email     String
  userId    Int?
  createdAt DateTime @default(now())

  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([watchId, email])
}

model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
